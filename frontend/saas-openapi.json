            }
          }
        }
      }
    },
    "/health/deps": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Deps",
        "description": "Per-dependency detail. Always 200 \u2014 this endpoint reports, it does not judge.\n\nSeparate from `/readyz` because they are read by different things: a load\nbalancer wants a status code, and a person wants to know which of three\ndependencies is the one that is broken.",
