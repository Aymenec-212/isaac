    "/meetings/{meeting_id}/end": {
      "post": {
        "tags": [
          "meetings"
        ],
        "summary": "End Meeting",
        "description": "End a meeting (tech spec 11). Idempotent: calling it twice is a no-op.\n\nOrdering matters. The drain runs to a durable boundary *before* the meeting\nis marked COMPLETED, so a crash mid-finalization leaves FINALIZING for the\nstartup recovery routine rather than a COMPLETED meeting missing segments.",
        "operationId": "end_meeting_meetings__meeting_id__end_post",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meeting Id"
            }
          },
          {
            "name": "authorization",
