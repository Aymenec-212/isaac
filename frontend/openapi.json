    "/meetings/{meeting_id}/audio/{session_id}": {
      "get": {
        "tags": [
          "meetings"
        ],
        "summary": "Get Audio",
        "description": "Stored PCM for one audio session, with Range support (tech spec 6, FR-11).\n\nThe review page seeks by timestamp, and `store.py` makes that arithmetic\nrather than a lookup: the file holds silence padding too, so\n`byte_offset = session_ms * BYTES_PER_MS` is exact. This route does not\nneed to know that \u2014 it answers in bytes and lets the caller do the sum.\n\nTenancy is enforced the same way every other read is, and then once more:\nthe `AudioSession` row must belong to the meeting named in the path, so a\nvalid session id from another meeting in the same organization cannot be\nreplayed here.",
        "operationId": "get_audio_meetings__meeting_id__audio__session_id__get",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meeting Id"
            }
          },
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
