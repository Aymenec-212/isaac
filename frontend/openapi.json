      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Could this instance take a meeting right now? (tech spec 15.)\n\n503 when not, with the reason in the body \u2014 a load balancer needs the\nstatus code, and the person reading the logs afterwards needs the sentence.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
