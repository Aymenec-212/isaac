            "title": "Evidence Segment Ids"
          },
          "owner_participant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Participant Id"
          },
          "owner_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Text"
          },
          "due_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Text"
          }
        },
        "type": "object",
        "required": [
          "text",
          "evidence_segment_ids"
        ],
        "title": "ActionItemView"
      },
      "AudioSessionView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "participant_id": {
            "type": "string",
            "title": "Participant Id"
          },
          "epoch_ms": {
            "type": "integer",
            "title": "Epoch Ms"
          }
        },
        "type": "object",
        "required": [
          "id",
          "participant_id",
          "epoch_ms"
        ],
        "title": "AudioSessionView",
        "description": "Where one participant's recording sits on the meeting timeline.\n\nThe review page needs `epoch_ms` to turn a segment's meeting-relative\n`start_ms` into an offset inside the file:\n\n    offset_ms = segment.start_ms - session.epoch_ms\n\nSent alongside the segments rather than repeated on each one, because it is\na property of the recording and there are a handful of recordings and\nhundreds of segments."
      },
      "CreateMeetingRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateMeetingRequest"
      },
      "CreateMeetingResponse": {
        "properties": {
          "meeting": {
            "$ref": "#/components/schemas/MeetingView"
          },
          "host_token": {
            "type": "string",
            "title": "Host Token"
          },
          "invite_url": {
            "type": "string",
            "title": "Invite Url"
          }
        },
        "type": "object",
        "required": [
          "meeting",
          "host_token",
          "invite_url"
        ],
        "title": "CreateMeetingResponse"
      },
      "DependencyView": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "gates_readiness": {
            "type": "boolean",
            "title": "Gates Readiness"
          }
        },
        "type": "object",
        "required": [
          "name",
          "state",
          "detail",
          "gates_readiness"
        ],
        "title": "DependencyView",
        "description": "One dependency's state (tech spec 15, `/health/deps`)."
      },
      "EndMeetingResponse": {
