{
  "name": "mosaique-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "node scripts/check-contrast.mjs && vitest run",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs --verbose",
    "generate:saas-api": "openapi-typescript saas-openapi.json -o src/saas/schema.d.ts",
    "test:e2e:saas": "playwright test --config=playwright.saas.config.ts",
    "test:e2e:prototype": "playwright test --config=playwright.prototype.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
