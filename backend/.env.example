# Copy to .env and adjust. Startup fails fast if anything required is missing.
MOSAIQUE_ENVIRONMENT=local
MOSAIQUE_DATABASE_URL=postgresql+asyncpg://mosaique:mosaique@localhost:5432/mosaique
# Minimum 32 characters. Generate with: openssl rand -base64 48
MOSAIQUE_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
MOSAIQUE_LOG_LEVEL=INFO
